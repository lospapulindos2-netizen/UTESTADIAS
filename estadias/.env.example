# Copia este archivo como .env y ajusta los valores
APP_NOMBRE=Gestión de Estadías
INSTITUCION=Universidad Tecnológica de Parral
INSTITUCION_CORTA=UTP
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/estadias?charset=utf8mb4
# Carpeta privada de archivos (fuera de app/static)
STORAGE_DIR=storage/privado
MAX_MB=10
# true en producción con HTTPS
COOKIE_SEGURA=false
SESION_HORAS=8
MYSQLDUMP=C:\xampp\mysql\bin\mysqldump.exe
BACKUP_DIR=respaldos
BACKUP_CONSERVAR=14
# Solo pruebas: permite crear cuentas (alumno, profesor o revisor) desde el inicio de sesion.
# Pon false antes de usar datos reales o de entregar.
MODO_DEMO=false
